{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.xcreener/xcreener-mcp",
  "description": "Local stdio MCP bridge for XCREENER's XQL screener API — validate, explain, and run queries.",
  "title": "XCREENER",
  "version": "0.2.0",
  "websiteUrl": "https://xcreener.com",
  "repository": {
    "url": "https://github.com/xcreener/xcreener-mcp",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@xcreener/mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "XCREENER_API_KEY",
          "description": "Your XCREENER API key (xcreener.com/account/api-key)",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
